# Salin jadi keystore.properties (lokal, sudah di-gitignore), lalu isi password asli.
#
# 1) Buat keystore SEKALI (di root project):
#    keytool -genkeypair -v -keystore xflix-release.jks -alias xflix -keyalg RSA -keysize 2048 -validity 10000 -storetype PKCS12
#
# 2) Isi nilai di bawah. Untuk PKCS12, storePassword == keyPassword.
#
# PENTING: simpan xflix-release.jks + password di tempat aman dan BACKUP.
# Pakai keystore yang SAMA untuk semua rilis — ganti = tidak bisa update aplikasi yang sudah terpasang.

storeFile=xflix-release.jks
storePassword=
keyAlias=xflix
keyPassword=
